# Maslul configuration.
#
#     cp .env.example .env        then fill in GEMINI_API_KEY
#
# .env is never committed. api/main.py calls load_dotenv() before any
# module reads os.environ, because uvicorn does not load .env itself.
#
# Every setting below has a working default except the API key. You can
# run the whole test suite with no .env at all.

# ---------------------------------------------------------------------------
# The model
# ---------------------------------------------------------------------------
# Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Blank uses the default. MEASURED on this project's prompt:
# gemini-3.5-flash-lite is 0.8-1.8s per turn, gemini-3.7-flash is
# 4.2-9.1s, with indistinguishable roleplay quality -- so Flash-Lite is
# the default. Try a Pro model only if the persona starts feeling flat;
# that is a quality call, not a latency one.
# Do NOT use gemini-2.5-* (end of life 16 Oct 2026).
GEMINI_MODEL=

# Thinking tokens are latency with no benefit for short radio traffic.
# "low" is the floor that works across models ("minimal" is rejected by
# gemini-3.7-flash). Set to "default" to re-enable full thinking.
GEMINI_REASONING_EFFORT=low

# Which provider builds the chat model. Only "gemini" ships today; the
# setting exists because selecting a local model for an air-gapped install
# must stay a config change rather than a code change.
LLM_PROVIDER=gemini

# ---------------------------------------------------------------------------
# Voice (Hebrew) -- Gemini Live, native speech-to-speech
# ---------------------------------------------------------------------------
# One model hears, reasons and speaks in a single session, so there is no
# separate STT or TTS key. Uses GEMINI_API_KEY above.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Voice name. Try others by ear -- Hebrew quality varies a lot.
GEMINI_LIVE_VOICE=Charon

# ---------------------------------------------------------------------------
# Limits, storage, logging
# ---------------------------------------------------------------------------
# Hard ceiling on model/tool steps in one turn. Reaching it produces a safe
# in-character fallback, never a crash.
AGENT_MAX_STEPS=8

MASLUL_DB_PATH=./maslul.db
LOG_LEVEL=INFO

# 1 installs a socket guard that RAISES on any outbound connection, so a
# stray cloud call fails loudly here instead of silently in a closed
# network. The test suite always runs with this on (tests/conftest.py).
MASLUL_OFFLINE=0
