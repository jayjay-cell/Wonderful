<!DOCTYPE html>
<!--
  Maslul — trainer UI.

  Deliberately a single self-contained file with no build step. A React +
  Vite setup would add a toolchain, a node_modules tree and a build
  artifact to carry into a closed network, for a two-pane chat UI. Plain
  HTML with ES modules is served directly by any static server and copies
  across as one file.

  Three things here are load-bearing rather than decorative:

  * The typing indicator stays visible through a PAUSE event. Without
    that, a hesitation looks like the app froze rather than like someone
    thinking — which inverts the whole point of the realism layer.
  * Sending a message calls /interrupt first, so cutting him off is a
    real capability rather than a queued message that arrives after he
    finishes.
  * A `composing` signal is sent as the trainee types, feeding the
    suppression guard so he does not talk over a half-written message.
-->
<html lang="he" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Maslul — סימולטור אימון</title>
<style>
  :root {
    --bg: #0f1419;
    --panel: #161c23;
    --panel-2: #1d242d;
    --line: #2a333e;
    --text: #e4e9ef;
    --muted: #8b99a8;
    --trainee: #2d4a63;
    --counterpart: #243029;
    --accent: #5aa9e6;
    --warn: #e6a35a;
    --urgent: #e65a5a;
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme="dark"]) {
      --bg: #f6f7f9; --panel: #fff; --panel-2: #eef1f4; --line: #d8dee5;
      --text: #1a2129; --muted: #667585; --trainee: #d6e4f0;
      --counterpart: #dfeade; --accent: #2b7fc4;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--bg); color: var(--text);
    font: 15px/1.5 -apple-system, "Segoe UI", system-ui, sans-serif;
    height: 100vh; display: grid; grid-template-columns: 1fr 320px;
  }
  @media (max-width: 760px) { body { grid-template-columns: 1fr; } #side { display: none; } }

  #main { display: flex; flex-direction: column; min-width: 0; }
  header {
    padding: 12px 16px; border-bottom: 1px solid var(--line);
    background: var(--panel); display: flex; align-items: center; gap: 12px;
  }
  header h1 { font-size: 15px; margin: 0; font-weight: 600; }
  header .clock {
    margin-inline-start: auto; font-variant-numeric: tabular-nums;
    color: var(--muted); font-size: 13px;
  }
  #log { flex: 1; overflow-y: auto; padding: 16px; display: flex;
         flex-direction: column; gap: 10px; }
  .msg { max-width: 76%; padding: 9px 13px; border-radius: 12px;
         white-space: pre-wrap; word-break: break-word; }
  .trainee { align-self: flex-start; background: var(--trainee); }
  .counterpart { align-self: flex-end; background: var(--counterpart); }
  .meta { font-size: 11px; color: var(--muted); margin-top: 4px; }
  .initiated { border-inline-end: 3px solid var(--warn); }
  .urgent { border-inline-end: 3px solid var(--urgent); }
  .garbled { opacity: .62; font-style: italic; letter-spacing: .4px; }
  .cut { color: var(--muted); }

  #typing { align-self: flex-end; display: none; gap: 4px; padding: 11px 15px;
            background: var(--counterpart); border-radius: 12px; }
  #typing.on { display: flex; }
  #typing i { width: 6px; height: 6px; border-radius: 50%; background: var(--muted);
              animation: blink 1.3s infinite; }
  #typing i:nth-child(2) { animation-delay: .18s; }
  #typing i:nth-child(3) { animation-delay: .36s; }
  @keyframes blink { 0%,60%,100% { opacity:.25 } 30% { opacity:1 } }

  footer { padding: 12px 16px; border-top: 1px solid var(--line); background: var(--panel); }
  form { display: flex; gap: 8px; }
  input[type=text] {
    flex: 1; padding: 10px 12px; border-radius: 9px; border: 1px solid var(--line);
    background: var(--panel-2); color: var(--text); font-size: 15px;
  }
  button {
    padding: 10px 16px; border-radius: 9px; border: 0; cursor: pointer;
    background: var(--accent); color: #fff; font-size: 14px; font-weight: 600;
  }
  button.ghost { background: var(--panel-2); color: var(--text); border: 1px solid var(--line); }
  button:disabled { opacity: .45; cursor: default; }

  #side { background: var(--panel); border-inline-start: 1px solid var(--line);
          overflow-y: auto; padding: 14px; }
  #side h2 { font-size: 12px; text-transform: uppercase; letter-spacing: .07em;
             color: var(--muted); margin: 0 0 8px; }
  .reading { display: flex; justify-content: space-between; gap: 8px;
             padding: 5px 0; border-bottom: 1px solid var(--line); font-size: 13px; }
  .reading .v { font-variant-numeric: tabular-nums; }
  .reading.hidden-param { color: var(--muted); }
  .reading.hidden-param .k::after { content: " (מוסתר)"; font-size: 11px; }
  #setup { padding: 28px; max-width: 540px; margin: 0 auto; }
  select { width: 100%; padding: 10px; border-radius: 9px; background: var(--panel-2);
           color: var(--text); border: 1px solid var(--line); font-size: 14px; }
  label { display: block; font-size: 13px; color: var(--muted); margin: 14px 0 5px; }
  .briefing { background: var(--panel-2); padding: 12px; border-radius: 9px;
              font-size: 13px; white-space: pre-wrap; margin-top: 14px; }
  .err { color: var(--urgent); font-size: 13px; margin-top: 10px; }
  .partial { opacity: .55; font-style: italic; }
  #level { display: inline-block; width: 46px; height: 5px; background: var(--panel-2);
           border-radius: 3px; overflow: hidden; vertical-align: middle; }
  #level i { display: block; height: 100%; width: 0; background: var(--accent);
             transition: width .08s linear; }
  button.muted { background: var(--urgent); color: #fff; }
</style>
</head>
<body>
<div id="main">
  <div id="setup">
    <h1 style="font-size:19px;margin:0 0 4px">Maslul</h1>
    <p style="color:var(--muted);font-size:13px;margin:0">סימולטור אימון שיחה</p>
    <label for="mission">משימה</label>
    <select id="mission"></select>
    <label for="speed">מהירות זמן משימה</label>
    <select id="speed">
      <option value="1">זמן אמת</option>
      <option value="10">×10</option>
      <option value="60" selected>×60 — דקה בשנייה</option>
    </select>
    <label for="mode">מצב</label>
    <select id="mode">
      <option value="live" selected>קולי (Gemini Live) — מהיר, ללא מפתח נוסף</option>
      <option value="voice">קולי (ElevenLabs) — איכות גבוהה, עם השהיות מבוקרות</option>
      <option value="text">טקסט</option>
    </select>
    <div id="briefing" class="briefing" hidden></div>
    <div id="setup-err" class="err" hidden></div>
    <button id="start" style="margin-top:18px;width:100%">התחל סימולציה</button>
  </div>

  <header hidden id="bar">
    <h1 id="title"></h1>
    <span id="counterpart" style="color:var(--muted);font-size:13px"></span>
    <span id="vstat" style="font-size:12px;color:var(--muted)"></span>
    <span class="clock" id="clock">T+00:00</span>
  </header>
  <div id="log" hidden>
    <div id="typing"><i></i><i></i><i></i></div>
  </div>
  <footer hidden id="composer">
    <form id="form">
      <input id="text" type="text" placeholder="תשדורת…" autocomplete="off">
      <button type="submit">שלח</button>
      <button type="button" class="ghost" id="mic" title="השתק מיקרופון" hidden>🎙</button>
      <button type="button" class="ghost" id="cut" title="קטע אותו">קטע</button>
      <button type="button" class="ghost" id="end">סיים</button>
    </form>
  </footer>
</div>

<aside id="side" hidden>
  <h2>מצב (תצוגת מדריך)</h2>
  <div id="readings"></div>
  <h2 style="margin-top:18px">נקודות שהופעלו</h2>
  <div id="fired" style="font-size:13px;color:var(--muted)"></div>
</aside>

<script type="module">
import { VoiceClient } from "./voice.js";

const API = location.origin.includes("5173") ? "http://localhost:8000" : "";
let voice = null, partialNode = null;
const $ = (id) => document.getElementById(id);
let session = null, stream = null, typingTimer = null, currentTone = "baseline";

// ---------- setup ----------
let missions = [];
try {
  const res = await fetch(`${API}/missions`);
  missions = (await res.json()).missions;
} catch {
  $("setup-err").hidden = false;
  $("setup-err").textContent = "השרת לא זמין. הפעל: uvicorn api.main:app";
}
for (const m of missions) {
  const opt = document.createElement("option");
  opt.value = m.file;
  opt.textContent = m.error ? `${m.file} — שגיאה` : `${m.title}`;
  opt.disabled = !!m.error;
  $("mission").append(opt);
}
const showBriefing = () => {
  const m = missions.find(x => x.file === $("mission").value);
  $("briefing").hidden = !m?.briefing;
  $("briefing").textContent = m?.briefing ?? "";
};
$("mission").onchange = showBriefing;
showBriefing();

$("start").onclick = async () => {
  $("start").disabled = true;
  // Unlock audio on this click. A browser suspends an AudioContext that
  // was not created during a user gesture, and the symptom is silence
  // with no error anywhere -- the single most likely cause of "sound
  // doesn't work".
  try {
    const probe = new AudioContext();
    await probe.resume();
    await probe.close();
  } catch { /* unlocking is best-effort */ }
  $("setup-err").hidden = true;
  try {
    const res = await fetch(`${API}/sessions`, {
      method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        mission_file: $("mission").value,
        delivery_speed: Number($("speed").value),
      }),
    });
    if (!res.ok) throw new Error((await res.json()).detail ?? "failed");
    session = await res.json();
    beginSession();
  } catch (err) {
    $("start").disabled = false;
    $("setup-err").hidden = false;
    $("setup-err").textContent = String(err.message ?? err);
  }
};

function beginSession() {
  $("setup").hidden = true;
  for (const id of ["bar", "log", "composer", "side"]) $(id).hidden = false;
  $("title").textContent = session.title;
  $("counterpart").textContent = `${session.counterpart_callsign} · אתה: ${session.trainee_callsign}`;
  $("text").focus();

  stream = new EventSource(`${API}/sessions/${session.session_id}/stream`);
  stream.onmessage = (e) => handleEvent(JSON.parse(e.data));
  setInterval(refreshState, 2000);
  refreshState();

  const mode = $("mode").value;
  if (mode === "voice" || mode === "live") startVoice(mode);
}

// ---------- voice ----------
async function startVoice(mode) {
  $("mic").hidden = false;
  $("vstat").textContent = "מתחבר…";
  voice = new VoiceClient({
    sessionId: session.session_id,
    apiBase: API,
    onEvent: handleVoiceEvent,
    endpoint: mode,          // "live" or "voice"
  });
  try {
    await voice.connect();
    $("vstat").textContent = "🎙 מקשיב";
    $("text").placeholder = "דבר, או הקלד אם לא מזהה…";
  } catch (err) {
    // A clear reason, not a dead mic: the two likely causes are a
    // refused permission and a missing API key, and they need different
    // fixes from the user.
    voice = null;
    $("vstat").textContent = "";
    appendMessage("counterpart", `קול לא זמין: ${err.message}. אפשר להמשיך בטקסט.`);
  }
}

function handleVoiceEvent(ev) {
  switch (ev.type) {
    case "voice_ready":
      $("vstat").textContent = "🎙 מקשיב";
      break;

    case "partial_transcript":
      // Shown live and greyed out, so the trainee can see when a brevity
      // code was misheard and correct it before the turn completes.
      if (!partialNode) {
        partialNode = appendMessage("trainee", "");
        partialNode.querySelector(".body").classList.add("partial");
      }
      partialNode.querySelector(".body").textContent = ev.text;
      scrollDown();
      break;

    case "final_transcript":
      if (partialNode) {
        const body = partialNode.querySelector(".body");
        body.classList.remove("partial");
        body.textContent = ev.text;
        partialNode = null;
      } else {
        appendMessage("trainee", ev.text);
      }
      break;

    case "barge_in":
      $("vstat").textContent = "🎙 קוטע…";
      setTimeout(() => { $("vstat").textContent = "🎙 מקשיב"; }, 900);
      break;

    case "error":
      appendMessage("counterpart", ev.message || "שגיאה בקול");
      break;

    case "counterpart_text": {
      // Gemini Live transcribes its own speech, so the transcript is
      // built from text events rather than delivery chunks. Appended to
      // the same bubble while the turn continues.
      if (!current) current = { parts: [], node: null, origin: "reactive" };
      if (!current.node) current.node = appendMessage("counterpart", "", current);
      current.node.querySelector(".body").textContent += ev.text;
      scrollDown();
      break;
    }

    case "turn_complete":
      current = null;
      showTyping(false);
      break;

    case "initiated":
      $("vstat").textContent = `🎙 יזם דיווח (${ev.trigger_id})`;
      setTimeout(() => { $("vstat").textContent = "🎙 מקשיב"; }, 2500);
      break;

    case "audio_error":
      // Surfaced rather than swallowed: silent audio with no explanation
      // is the worst failure mode, because nothing suggests what to try.
      appendMessage("counterpart", `בעיה בהשמעה: ${ev.message}`);
      break;

    case "voice_closed":
      $("vstat").textContent = "קול התנתק";
      break;
  }
}

$("mic").onclick = () => {
  if (!voice) return;
  const muting = !voice.muted;
  voice.setMuted(muting);
  $("mic").classList.toggle("muted", muting);
  $("mic").textContent = muting ? "🔇" : "🎙";
  $("vstat").textContent = muting ? "מיקרופון מושתק" : "🎙 מקשיב";
};

// ---------- delivery events ----------
// Each branch is the TEXT rendering of a scheduler event. The same events
// will drive audio in the voice phase, which is why nothing here decides
// timing — it only renders what the plan already resolved.
let current = null;

function handleEvent(ev) {
  switch (ev.type) {
    case "utterance_start":
      current = { parts: [], node: null, origin: ev.origin, trigger: ev.trigger_id };
      currentTone = "baseline";
      break;

    case "typing_start":
      showTyping(true);
      break;

    case "pause":
      // Keep the indicator ALIVE through a hesitation. Hiding it here
      // would make a pause look like the app froze, inverting the point
      // of the realism layer.
      showTyping(true);
      break;

    case "tone_shift":
      currentTone = ev.tone;
      break;

    case "chunk": {
      showTyping(false);
      if (!current.node) current.node = appendMessage("counterpart", "", current);
      const span = document.createElement("span");
      span.textContent = (current.parts.length ? " " : "") + ev.text;
      if (ev.garbled) span.className = "garbled";
      current.node.querySelector(".body").append(span);
      current.parts.push(ev.text);
      if (currentTone === "urgent") current.node.classList.add("urgent");
      scrollDown();
      break;
    }

    case "self_correction": {
      if (current?.node) {
        const span = document.createElement("span");
        span.className = "cut";
        span.textContent = " — ";
        current.node.querySelector(".body").append(span);
      }
      break;
    }

    case "interrupted":
      showTyping(false);
      if (current?.node) {
        const meta = current.node.querySelector(".meta");
        meta.textContent = (meta.textContent + " · נקטע").trim();
        current.node.classList.add("cut");
      }
      current = null;
      break;

    case "utterance_end":
      showTyping(false);
      current = null;
      break;
  }
}

function showTyping(on) {
  clearTimeout(typingTimer);
  const el = $("typing");
  if (on) {
    el.classList.add("on");
    $("log").append(el);          // keep it last in the log
    scrollDown();
    // Safety net: if an end event is ever missed the indicator must not
    // spin forever, which would read as a hung session.
    typingTimer = setTimeout(() => el.classList.remove("on"), 30000);
  } else {
    el.classList.remove("on");
  }
}

function appendMessage(who, text, info) {
  const wrap = document.createElement("div");
  wrap.className = `msg ${who}`;
  if (info?.origin === "initiated") wrap.classList.add("initiated");

  const body = document.createElement("div");
  body.className = "body";
  body.textContent = text;
  wrap.append(body);

  const meta = document.createElement("div");
  meta.className = "meta";
  meta.textContent = info?.trigger ? `יזום · ${info.trigger}` : "";
  wrap.append(meta);

  $("log").insertBefore(wrap, $("typing"));
  scrollDown();
  return wrap;
}

const scrollDown = () => { $("log").scrollTop = $("log").scrollHeight; };

// ---------- trainee input ----------
$("form").onsubmit = async (e) => {
  e.preventDefault();
  const text = $("text").value.trim();
  if (!text) return;
  $("text").value = "";
  appendMessage("trainee", text);

  // Interrupt FIRST, so cutting him off is real rather than a message
  // queued behind the rest of his transmission.
  if (voice) {
    // In voice mode the socket owns turn handling, so a typed
    // transmission goes the same way -- otherwise two paths could start a
    // turn at once.
    voice.interrupt();
    voice.sendText(text);
    return;
  }
  await post(`/sessions/${session.session_id}/interrupt`);
  await post(`/sessions/${session.session_id}/messages`, { text });
};

let composingSent = false;
$("text").oninput = () => {
  const composing = $("text").value.length > 0;
  if (composing !== composingSent) {
    composingSent = composing;
    // Feeds the suppression guard: he waits rather than talking over a
    // half-written transmission.
    post(`/sessions/${session.session_id}/composing`, { composing });
  }
};

$("cut").onclick = () => {
  if (voice) voice.interrupt();
  else post(`/sessions/${session.session_id}/interrupt`);
};
$("end").onclick = async () => {
  await voice?.close();
  await post(`/sessions/${session.session_id}/end`);
  stream?.close();
  location.reload();
};

async function post(path, body) {
  try {
    await fetch(API + path, {
      method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body ?? {}),
    });
  } catch { /* a failed signal must never break the conversation */ }
}

// ---------- trainer panel ----------
// Shows the FULL state, including what the counterpart cannot see: to
// judge whether his answers were honest you need to know what he does not.
async function refreshState() {
  if (!session) return;
  try {
    const res = await fetch(`${API}/sessions/${session.session_id}/state`);
    if (!res.ok) return;
    const state = await res.json();

    const total = Math.floor(state.mission_seconds);
    $("clock").textContent =
      `T+${String(Math.floor(total / 60)).padStart(2, "0")}:${String(total % 60).padStart(2, "0")}`;

    $("readings").innerHTML = "";
    for (const r of state.readings) {
      const row = document.createElement("div");
      row.className = "reading" + (r.hidden_from_counterpart ? " hidden-param" : "");
      const value = typeof r.value === "number" ? Math.round(r.value * 10) / 10 : r.value;
      row.innerHTML =
        `<span class="k">${r.name}</span><span class="v">${r.say_as ?? value}${r.unit ? " " + r.unit : ""}</span>`;
      $("readings").append(row);
    }

    const fired = Object.keys(state.fired ?? {});
    $("fired").textContent = fired.length ? fired.join(", ") : "—";
  } catch { /* the panel is advisory; a failed poll must not interrupt */ }
}
</script>
</body>
</html>
