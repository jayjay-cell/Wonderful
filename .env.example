# Maslul configuration. Copy to .env and fill in.
#
#   cp .env.example .env
#
# .env is never committed. api/main.py calls load_dotenv() before any
# module reads os.environ, because uvicorn does not load .env itself.

# ---------------------------------------------------------------------------
# Provider selection -- the air-gap seam (docs/ARCHITECTURE.md §4)
# ---------------------------------------------------------------------------
# Switching between cloud and local is THIS LINE ONLY, never a code change.
#   gemini    : development (needs GEMINI_API_KEY)
#   anthropic : development (needs ANTHROPIC_API_KEY)
#   ollama    : local model, works air-gapped
LLM_PROVIDER=gemini

# Only read when LLM_PROVIDER=gemini. Key from https://aistudio.google.com/apikey
# Leave blank in a closed network.
GEMINI_API_KEY=
# Default gemini-3.7-flash. Do NOT use gemini-2.5-* (end of life 16 Oct 2026).
# MEASURED on this project's prompt: gemini-3.5-flash-lite is 0.8-1.8s
# per turn, gemini-3.7-flash is 4.2-9.1s, with indistinguishable roleplay
# quality. Flash-Lite is the default. Try a Pro model if the persona
# starts feeling flat -- that is a quality call, not a latency one.
# Do NOT use gemini-2.5-* (end of life 16 Oct 2026).
GEMINI_MODEL=

# Thinking tokens are latency with no benefit for short radio traffic.
# "low" is the floor that works across models ("minimal" is rejected by
# gemini-3.7-flash). Set to "default" to re-enable full thinking.
GEMINI_REASONING_EFFORT=low

# Only read when LLM_PROVIDER=anthropic. Leave blank in a closed network.
ANTHROPIC_API_KEY=

# Only read when LLM_PROVIDER=ollama. Default suits a local Ollama install.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# ---------------------------------------------------------------------------
# VOICE (Hebrew). One key covers both STT and TTS.
# ---------------------------------------------------------------------------
# Get a key at https://elevenlabs.io -- the free tier is enough to test.
ELEVENLABS_API_KEY=

# ---------------------------------------------------------------------------
# VOICE MODE: pick one in the UI at session start.
#
#   Gemini Live   native speech-to-speech. NO EXTRA KEY -- uses
#                 GEMINI_API_KEY. ~1.1s to first Hebrew audio. Gives up the
#                 realism layer: it owns its own pauses, so no controlled
#                 stalls or state-driven garbling.
#
#   ElevenLabs    cascade: STT -> your agent -> TTS. Keeps the full realism
#                 layer and deterministic pacing. ~1.5-2.5s. Needs a key.
#
# Both preserve the mission-state guarantee: measured, Gemini Live DOES
# call read_state before quoting a figure.
# ---------------------------------------------------------------------------

# Gemini Live. Model names change often; blank uses the verified default.
GEMINI_LIVE_MODEL=
# Voice name. Try others by ear -- Hebrew quality varies.
GEMINI_LIVE_VOICE=Charon

STT_PROVIDER=elevenlabs
TTS_PROVIDER=elevenlabs

# TTS MODEL: eleven_flash_v2_5 is the default and should stay that way for
# live use. Measured by others and widely reported: eleven_v3 takes about
# SEVEN SECONDS per Hebrew sentence, Flash v2.5 about one. v3 has nicer
# voices and audio tags but is built for pre-rendered audio.
ELEVENLABS_TTS_MODEL=

# VOICE: Hebrew quality varies a LOT between voices. This is the first
# thing to change by ear -- browse https://elevenlabs.io/voice-library and
# paste a voice id here.
ELEVENLABS_VOICE_ID=

# STT model. Scribe v2 Realtime: ~150ms, 90+ languages.
ELEVENLABS_STT_MODEL=

# ---------------------------------------------------------------------------
# Offline enforcement
# ---------------------------------------------------------------------------
# 1 installs a socket guard that RAISES on any outbound connection, so a
# cloud call fails loudly here instead of silently in a closed network.
# The test suite always runs with this on (tests/conftest.py).
MASLUL_OFFLINE=0

# ---------------------------------------------------------------------------
# Agent limits
# ---------------------------------------------------------------------------
# Hard ceiling on model/tool steps in one turn. Reaching it produces a safe
# in-character fallback, never a crash (FR-G1/G2).
AGENT_MAX_STEPS=8

# ---------------------------------------------------------------------------
# Storage and logging
# ---------------------------------------------------------------------------
MASLUL_DB_PATH=./maslul.db
LOG_LEVEL=INFO

# Fixes the realism RNG for reproducible sessions. Blank = random per
# session. A mission file's realism.seed overrides this.
REALISM_SEED=
